# CampusGig - Root Environment Reference
# See server/.env.example and client/.env.example for component-specific configurations

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/campusgig
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d
COOKIE_NAME=campusgig_session

# Optional Cloudinary (for real portfolio image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=5

# Optional SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@campusgig.local

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
