# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database Connection
# For local MongoDB: mongodb://127.0.0.1:27017/campusgig
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusgig?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/campusgig

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_campusgig
JWT_EXPIRES_IN=7d
COOKIE_NAME=campusgig_session

# Cloudinary Portfolio Uploads (Optional: provide credentials for live uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=5

# Optional SMTP Email Configuration (for verification and password resets)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@campusgig.local
